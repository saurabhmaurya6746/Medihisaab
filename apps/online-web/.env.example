# MediHisaab Online Web & Client Portal Configuration Example
#
# In local development:
# Leave unset or set to http://127.0.0.1:8000 (Vite dev server proxies /api and /health to port 8000)
#
# In production release builds:
# Set to the canonical HTTPS domain of the Central Licensing API (e.g. https://licensing.apexhealth.com)
# The production build will fail if this is missing or points to localhost/127.0.0.1.
VITE_LICENSING_API_URL=https://licensing.apexhealth.com
