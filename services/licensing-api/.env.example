# Pharmacy POS Central Vendor Licensing API Environment Configuration
# Copy this file to .env and provide production credentials. NEVER commit .env to version control!

# Environment mode: production, staging, development
ENVIRONMENT=production

# Database Connection URL
# For local development: sqlite:///./licensing_dev.db
# For production (Supabase Session Pooler URL):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# For production (Render PostgreSQL): postgresql+psycopg2://user:password@host:5432/pharmacy_licensing
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# JWT Authentication Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=REPLACE_WITH_SECURE_64_CHAR_HEX_SECRET_FOR_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# CORS Allowed Origins (Comma-separated list of permitted origins; desktop origins http://127.0.0.1:38291, http://127.0.0.1:5173 are always included by default)
ALLOWED_ORIGINS=https://medihisaab.onrender.com,https://medihisaab-portal.onrender.com,https://pharmacy-pos-portal.onrender.com,http://127.0.0.1:38291,http://localhost:38291
CORS_ORIGINS=https://medihisaab.onrender.com,https://medihisaab-portal.onrender.com,https://pharmacy-pos-portal.onrender.com,http://127.0.0.1:38291,http://localhost:38291

# Ed25519 Private Signing Key (PEM format)
# Generate with:
# python -c "from cryptography.hazmat.primitives.asymmetric import ed25519; from cryptography.hazmat.primitives import serialization; k = ed25519.Ed25519PrivateKey.generate(); print(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode())"
# Or provide as a single-line string with literal \n escapes:
LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIP...YOUR_ED25519_PRIVATE_KEY_PEM...\n-----END PRIVATE KEY-----"

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# SMTP Notification Settings for Vendor Renewal Alerts (Optional)
# If unconfigured, renewal requests are safely recorded in the database for vendor admin portal review.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD_OR_API_KEY
SMTP_FROM=noreply@apexhealth.local
VENDOR_NOTIFICATION_EMAIL=billing-alerts@apexhealth.local

